@model Blog.ViewModels.ArticlesIndexViewModel

<div class="page-header mb-4">
    <h1>Все статьи</h1>
    <a asp-controller="Articles" asp-action="Create" class="text-decoration-none">Добавить статью</a>
</div>

@if (Model?.Articles == null || !Model.Articles.Any())
{
    <p class="text-muted">Статей пока нет.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var article in Model.Articles)
        {
            <div class="col">
                <div class="card article-card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">@article.Title</h5>
                        <p class="card-text text-muted flex-grow-1">
                            @(article.Content.Length > 150 ? article.Content.Substring(0, 150) + "..." : article.Content)
                        </p>
                        <div class="mt-auto pt-3 border-top">
                            <small class="text-muted me-3">
                                Автор: @(article.Author?.Username ?? "—")
                            </small>
                            <small class="text-muted">
                                @article.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                        <div class="mt-2">
                            @if (article.ArticleTags != null && article.ArticleTags.Any())
                            {
                                foreach (var at in article.ArticleTags.Take(3))
                                {
                                    <span class="badge bg-light text-dark me-1">@at.Tag.Name</span>
                                }
                                if (article.ArticleTags.Count > 3)
                                {
                                    <span class="badge bg-light text-dark ms-1">+@(article.ArticleTags.Count - 3)</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-secondary text-white">Без тегов</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 text-end">
                        <a asp-controller="Articles" asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-outline-primary me-2">Редактировать</a>
                        <a asp-controller="Articles" asp-action="Delete" asp-route-id="@article.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </div>
                </div>
            </div>
        }
    </div>
}